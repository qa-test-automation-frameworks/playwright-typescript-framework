# Controlled Conduit target UI URL. Run with `npm run with:target -- <command>`.
BASE_URL=http://127.0.0.1:4300

# Controlled Conduit target API URL.
API_URL=http://127.0.0.1:4300/api

# Seed user credentials for the controlled target. Use the target wrapper for local defaults,
# or replace these placeholders when running against an external environment.
TEST_USER_EMAIL=replace-with-controlled-target-email@example.test
TEST_USER_PASSWORD=replace-with-controlled-target-password
TEST_USER_USERNAME=replace-with-controlled-target-username
