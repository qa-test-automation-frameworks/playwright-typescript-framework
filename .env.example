# Controlled Conduit target UI URL. Run with `npm run with:target -- <command>`.
BASE_URL=http://127.0.0.1:4300

# Controlled Conduit target API URL.
API_URL=http://127.0.0.1:4300/api

# Seed user credentials for the controlled target. Override these for external environments.
TEST_USER_EMAIL=portfolio-seed@example.test
TEST_USER_PASSWORD=portfolio-seed-password
TEST_USER_USERNAME=portfolio_seed
